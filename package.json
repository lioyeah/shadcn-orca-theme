{
  "name": "neubrutalism-orca-theme",
  "version": "1.0.0",
  "description": "A Neubrutalism-style theme for Orca Notes — hard shadows, thick borders, zero border-radius.",
  "type": "module",
  "scripts": {
    "build:css": "node scripts/build-theme-css.cjs",
    "build:deploy": "npm run deploy",
    "dev": "npm run build:css && vite",
    "build": "npm run build:css && cross-env NODE_ENV=production tsc && vite build",
    "deploy": "npm run build && node scripts/deploy.cjs",
    "lint:css": "stylelint \"src/theme-css/**/*.css\" \"src/flavors/**/*.css\"",
    "check": "npm run build && npm run lint:css",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "valtio": "^1.13.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "rollup-plugin-external-globals": "^0.13.0",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
